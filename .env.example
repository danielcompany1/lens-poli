NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lens_polytechnic_sims
DB_USER=root
DB_PASSWORD=
# SMTP is optional for local development. Configure to deliver verification/reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Lens Polytechnic Portal <no-reply@lenspolytechnic.edu.ng>
# Set only when provisioning the first administrator through `npm run setup:admin`
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=
